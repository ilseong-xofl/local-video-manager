{
  "name": "local-video-manager",
  "productName": "Local Video Manager",
  "version": "0.3.0",
  "description": "Local-first video library manager for Windows desktops",
  "author": "Local Video Manager Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/ilseong-xofl/local-video-manager.git"
  },
  "main": ".webpack/main",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "ffmpeg-static"
    ],
    "overrides": {
      "tar": "7.5.22",
      "tmp": "0.2.7",
      "uuid": "11.1.1",
      "webpack-dev-server": "5.2.6"
    }
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-squirrel-startup": "1.0.1",
    "ffmpeg-static": "5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "update-electron-app": "3.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "9.39.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vercel/webpack-asset-relocator-loader": "1.10.0",
    "css-loader": "7.1.4",
    "electron": "43.3.0",
    "eslint": "9.39.5",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "globals": "17.9.0",
    "node-loader": "2.1.0",
    "prettier": "3.9.6",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10",
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2"
  }
}
